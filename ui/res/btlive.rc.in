/* Generated from btlive.rc.in - the version comes from project() in
 * CMakeLists.txt, so Explorer's file properties cannot drift away from the
 * release the way they did between 0.1.7 and 0.1.22. */
#include <windows.h>

/* 1 is what Windows shows for the file in Explorer: the lowest-numbered icon
 * resource wins, so this must stay 1. */
1 ICON "btlive.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @BT_VER_MAJOR@,@BT_VER_MINOR@,@BT_VER_PATCH@,0
PRODUCTVERSION  @BT_VER_MAJOR@,@BT_VER_MINOR@,@BT_VER_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Gary Lobermier"
            VALUE "FileDescription",  "BackingTrackLive"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "BackingTrackLive"
            VALUE "LegalCopyright",   "Copyright 2026 Gary Lobermier. Apache-2.0."
            VALUE "OriginalFilename", "BackingTrackLive.exe"
            VALUE "ProductName",      "BackingTrackLive"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
