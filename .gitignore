# Build (build/, build-asan/, build-fuzz/, ...)
build*/
out/
*.o
*.a
*.so
*.dylib
*.exe
*.pdb
compile_commands.json
.cache/

# Machine-local device routing (NEVER commit - differs per laptop/interface)
device.json
**/device.json

# Vendored SDK that cannot be redistributed (see docs/asio.md)
third_party/asiosdk/

# Test + render artifacts
*.wav.actual
tests/golden/*.actual
fuzz/corpus/
fuzz/crashes/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated demo stems (regenerate with examples/setlist/make_demo_tracks.py)
examples/setlist/tracks/

# Test fixtures written into the working directory. The tests remove their
# own, but a fixture added without updating cleanup() should not be able to
# reach a commit.
/val_*.wav
/val_setlist.json
/player_stem_*.wav
/player_setlist.json
